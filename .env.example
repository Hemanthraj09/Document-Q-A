# Ollama settings
OLLAMA_MODEL=phi3:latest
OLLAMA_URL=http://localhost:11434
# Context window sent to Ollama; phi3:latest supports 4096 tokens
OLLAMA_NUM_CTX=4096
MAX_ANSWER_TOKENS=768

# Embeddings run on CPU so the LLM keeps the GPU's VRAM
EMBED_DEVICE=cpu

# Storage (defaults live next to main.py)
# DATA_DIR=./data
# CHROMA_DIR=./chroma_db

MAX_UPLOAD_MB=50
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO
